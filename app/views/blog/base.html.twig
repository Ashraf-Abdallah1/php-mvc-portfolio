{% extends "partials/base.html.twig" %}
{% set pageTitle = "Blogs" %}
{% block body %}
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="card shadow-lg p-4" style="width: 1200px; border-radius: 12px;">
            <h2 class="text-center mb-4 text-primary">{{ pageTitle|capitalize }}</h2>

            {% block formContent %}{% endblock %}
            {% block content %} {% endblock %}
        </div>

    </div>


{% endblock %}