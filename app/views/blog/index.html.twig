{% extends "blog/base.html.twig" %}

{% block content %}

    <div class="container mt-5" style="max-width: 900px;">

        {% if isAdmin %}
            <div class="d-flex justify-content-center mb-4">
                <a href="/blogs/create"
                   class="btn btn-success px-4 py-2 shadow-sm d-flex align-items-center gap-2 rounded-3">
                    <i class="bi bi-pencil-square"></i>
                    Niuew Blog
                </a>
            </div>
            <canvas id="blogChart" height="120"></canvas>
        {% endif %}

        <div id="blog-list">
            <div class="text-center text-secondary">Blogs worden geladen...</div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/assets/js/blogs.js"></script>
{% endblock %}
