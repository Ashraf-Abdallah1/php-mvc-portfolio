{% extends 'user/partials.html.twig' %}
{% set pageTitle = "Login" %}

{% block formContent %}
    <form method="POST" action="/login">

        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text"
                   class="form-control"
                   id="username"
                   name="username"
                   placeholder="unique"
                   value="{{ old.username ?? '' }}"
                   required>
            {% if errors.username|e %}
                <div class="text-danger small mt-1">{{ errors.username|e }}</div>
            {% endif %}
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password"
                   class="form-control"
                   id="password"
                   name="password"
                   placeholder="password"
                   required>
            {% if errors.password %}
                <div class="text-danger small mt-1">{{ errors.password|e }}</div>
            {% endif %}
        </div>

        <button type="submit" class="btn btn-primary w-100">Log in</button>

        <p class="text-center mt-3">
            <a href="/register" class="text-decoration-none">Geen account? Register hier</a>
        </p>
    </form>
{% endblock %}
