{% extends "partials/baseLogin.html.twig" %}
{% block body %}
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
        <div class="card shadow-lg border-0 rounded-4 p-5 text-center" style="max-width: 550px;">

            <h1 class="fw-bold text-success mb-3" style="font-size: 2.4rem;">
                401 – Niet ingelogd
            </h1>

            <p class="text-muted fs-5 mb-3">
                Je hebt geen toegang tot deze pagina omdat je niet bent ingelogd.
            </p>

            <p class="mb-4">
                Log in om verder te gaan en toegang te krijgen tot beveiligde onderdelen van de website.
            </p>

            <div class="text-center mt-4">
                <a href="/login"
                   class="btn btn-success px-3 py-1 rounded-pill shadow-sm fw-semibold d-inline-flex align-items-center gap-2"
                   style="font-size: 1.2rem;">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Naar login
                </a>
            </div>

        </div>
    </div>
{% endblock %}
