{% extends "dashboard/base.html.twig" %}
{% block content %}
    <div class="container mt-5" style="max-width: 900px;">

        <h2 class="fw-bold text-success mb-4">Dashboard Aanpassen</h2>

        <div class="card shadow-lg border-0 rounded-4 mb-4">
            <div class="card-body p-4">

                <h4 class="fw-bold text-success d-flex align-items-center gap-2">
                    <i class="bi bi-mortarboard"></i> Studiepunten aanpassen
                </h4>

                <form method="POST" action="/dashboard/update-credits" class="mt-3">

                    <label class="fw-semibold">Behaalde studiepunten</label>
                    <input type="number" name="earned" class="form-control mb-3" min="0"
                           value="{{ dashboard.earnedCredits }}" required>

                    <label class="fw-semibold">Totaal studiepunten</label>
                    <input type="number" name="total" min="1" class="form-control mb-3"
                           value="{{ dashboard.totalCredits }}" required>

                    <button class="btn btn-success px-4">Opslaan</button>
                </form>

            </div>
        </div>

        <div class="card shadow-lg border-0 rounded-4 mb-4">
            <div class="card-body p-4">

                <h4 class="fw-bold text-success d-flex align-items-center gap-2">
                    <i class="bi bi-bar-chart"></i> Cijfers aanpassen
                </h4>

                {% for course, grade in dashboard.grades %}
                    <div class="card shadow-sm border-0 rounded-3 p-3 mb-3">

                        <div class="d-flex justify-content-between align-items-center">

                            <div class="flex-grow-1 me-3">
                                <form method="POST" action="/dashboard/update-grade"
                                      class="d-flex align-items-center gap-3">
                                    <input type="hidden" name="course" value="{{ course }}">

                                    <div class="w-50">
                                        <label class="fw-semibold">{{ course }}</label>
                                    </div>

                                    <input type="number" step="0.1" name="grade" min="0"
                                           class="form-control border-success shadow-sm"
                                           value="{{ grade }}" required>

                                    <button class="btn btn-success px-4 shadow-sm d-flex align-items-center gap-2">
                                        <i class="bi bi-check-lg"></i> Opslaan
                                    </button>
                                </form>
                            </div>

                            <form method="POST" action="/dashboard/delete-course" class="ms-3">
                                <input type="hidden" name="course" value="{{ course }}">
                                <button class="btn btn-danger px-4 shadow-sm d-flex align-items-center gap-2">
                                    <i class="bi bi-trash"></i> Verwijderen
                                </button>
                            </form>

                        </div>

                    </div>

                {% endfor %}

            </div>
        </div>


        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4">

                <h4 class="fw-bold text-success d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle"></i> Nieuw vak toevoegen
                </h4>

                <form method="POST" action="/dashboard/add-course" class="mt-3">

                    <label class="fw-semibold">Vaknaam</label>
                    <input type="text" name="course" class="form-control mb-3" required>

                    <label class="fw-semibold">Cijfer</label>
                    <input type="number" step="0.1" name="grade" min="0" class="form-control mb-3" required>

                    <button class="btn btn-success px-4">Toevoegen</button>
                </form>

            </div>
        </div>

    </div>
{% endblock %}