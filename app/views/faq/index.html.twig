{% extends "faq/base.html.twig" %}
{% block body %}

    <div class="min-vh-100 d-flex flex-column"
         style="background: linear-gradient(135deg, #e9f7ef, #d4f0e0);">

        <main class="container flex-grow-1 py-5">

            <div class="text-center mb-5">
                <h1 class="fw-bold text-success">Veelgestelde vragen (FAQ)</h1>
                <p class="text-secondary fs-5">Handige informatie voor HZ-studenten</p>
            </div>

            <div class="row justify-content-center g-4">

                <div class="col-lg-8">

                    <article class="p-4 bg-white shadow rounded-4 border-start border-4 border-success mb-4">
                        <details>
                            <summary class="fw-semibold text-success">Hoe print ik vanaf mijn laptop op de HZ?</summary>
                            <p class="mt-3 text-secondary">
                                Log in op
                                <a href="https://hz.mynetpay.nl" target="_blank" class="fw-semibold text-success">
                                    hz.mynetpay.nl
                                </a>
                                met je HZ‑account. Download daarna de printer‑app en log opnieuw in.
                                De HZ‑printers worden automatisch toegevoegd.
                                Printen kost €0,15 per pagina, dus zorg dat je saldo op je Scalda‑pas hebt staan.
                            </p>
                        </details>
                    </article>

                    <article class="p-4 bg-white shadow rounded-4 border-start border-4 border-success mb-4">
                        <details>
                            <summary class="fw-semibold text-success">Hoe scan ik en stuur ik het naar mijn laptop?</summary>
                            <p class="mt-3 text-secondary">
                                Houd je HZ‑pas tegen de printer om in te loggen.
                                Scan vervolgens je documenten.
                                De gescande bestanden worden automatisch naar jouw HZ‑mail gestuurd.
                            </p>
                        </details>
                    </article>

                    <article class="p-4 bg-white shadow rounded-4 border-start border-4 border-success mb-4">
                        <details>
                            <summary class="fw-semibold text-success">Hoe koop ik iets via de HZ‑webshop?</summary>
                            <p class="mt-3 text-secondary">
                                Ga naar
                                <a href="https://webshop.hz.nl" target="_blank" class="fw-semibold text-success">
                                    de HZ‑webshop
                                </a>.
                                Kies je producten zoals in elke andere webshop en rond de betaling af.
                            </p>
                        </details>
                    </article>

                    <article class="p-4 bg-white shadow rounded-4 border-start border-4 border-success mb-4">
                        <details>
                            <summary class="fw-semibold text-success">Hoe boek ik een projectruimte?</summary>
                            <p class="mt-3 text-secondary">
                                Ga naar
                                <a href="https://hzuniversity.topdesk.net/tas/public/ssp/content/detail/service?unid=7e54d40b762c4dc79205e200f0d4d818"
                                   target="_blank" class="fw-semibold text-success">
                                    de HZ Service Portal
                                </a>.
                                Klik op “Reserveer een ruimte”, kies een beschikbare ruimte en vul de gevraagde gegevens in.
                            </p>
                        </details>
                    </article>

                    <article class="p-4 bg-white shadow rounded-4 border-start border-4 border-success mb-4">
                        <details>
                            <summary class="fw-semibold text-success">Hoe werkt parkeren bij de HZ?</summary>
                            <p class="mt-3 text-secondary">
                                Meer informatie vind je
                                <a href="https://hz.nl/nieuws/parkeren-in-middelburg" target="_blank" class="fw-semibold text-success">
                                    op de HZ‑website
                                </a>.
                                Medewerkers moeten eerst een formulier invullen en kunnen parkeren bij het PZEM‑gebouw.
                                Studenten parkeren in de parkeergarage Kousteensedijk, op ongeveer 6 minuten lopen van de HZ.
                            </p>
                        </details>
                    </article>

                </div>

            </div>

        </main>

        <footer class="py-3 text-center text-secondary">
            © {{ "now"|date("Y") }} Mohamad Ashraf Abdallah
        </footer>

    </div>

{% endblock %}