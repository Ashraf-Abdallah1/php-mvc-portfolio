{% extends "brokers/base.twig" %}

{% block content %}
    <div class="text-end mb-3">
        <a href="/agents/create" class="btn btn-primary">Add New Agent</a>
    </div>
    <table class="table table-striped align-middle">
        <thead class="table-dark">
        <tr>
            <th style="width: 90%">Name</th>
            <th style="width: 10%">View</th>
        </tr>
        </thead>
        <tbody>
        {% for agent in agents %}
            <tr>
                <td>{{ agent.name }}</td>
                <td><a href="/agents/{{ agent.id }}" class="btn btn-info">View</a></td>
                <td><a href="/agents/{{ agent.id }}/bid" class="btn btn-info">bid</a></td>

            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}