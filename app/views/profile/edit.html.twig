{% extends "profile/base.html.twig" %}


{% block content %}
    <div class="container mt-5" style="max-width: 700px;">
        <div class="card shadow-sm border-0 p-4">

            <h3 class="fw-bold text-success mb-3">Profiel Bewerken</h3>

            <form method="POST" action="/profile/{{ profile.id }}">

                <label class="fw-semibold">Naam</label>
                <input type="text" name="name" class="form-control mb-3"
                       value="{{ profile.name|e }}" required>

                <label class="fw-semibold">Bio</label>
                <textarea name="bio" class="form-control mb-3" rows="3">{{ profile.bio|e }}</textarea>

                <label class="fw-semibold">Skills</label>
                <textarea name="skills" class="form-control mb-3" rows="3">{{ profile.skills|e }}</textarea>

                <label class="fw-semibold">Ervaring</label>
                <textarea name="experience" class="form-control mb-3" rows="3">{{ profile.experience|e }}</textarea>

                <label class="fw-semibold">Projecten</label>
                <textarea name="projects" class="form-control mb-3" rows="3">{{ profile.projects|e }}</textarea>

                <label class="fw-semibold">Contact</label>
                <input type="text" name="contact" class="form-control mb-3"
                       value="{{ profile.contact|e }}">

                <button class="btn btn-success px-4">Opslaan</button>
            </form>

        </div>
    </div>
{% endblock %}