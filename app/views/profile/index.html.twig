{% extends "profile/base.html.twig" %}

{% block content %}
    <div class="container mt-5" style="max-width: 900px;">

        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">

                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-success bg-opacity-10 d-flex justify-content-center align-items-center"
                         style="width: 90px; height: 90px;">
                        <i class="bi bi-person-circle text-success" style="font-size: 3rem;"></i>
                    </div>

                    <div class="ms-4">
                        <h2 class="fw-bold text-success mb-1">{{ profile.name|e }}</h2>
                        <p class="text-muted mb-0">Mijn persoonlijke profiel</p>
                    </div>
                </div>

                <hr>

                <div class="mb-4">
                    <h5 class="fw-bold text-success d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-text"></i> Bio
                    </h5>
                    <p class="text-muted">{{ profile.bio|e }}</p>
                </div>

                <hr>

                <div class="mb-4">
                    <h5 class="fw-bold text-success d-flex align-items-center gap-2">
                        <i class="bi bi-lightning-charge"></i> Skills
                    </h5>
                    <div class="d-flex flex-wrap gap-2">
                        {% for skill in profile.skills|split(',') %}
                            <span class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill shadow-sm">
                            {{ skill|trim|e }}
                        </span>
                        {% endfor %}
                    </div>
                </div>

                <hr>

                <div class="mb-4">
                    <h5 class="fw-bold text-success d-flex align-items-center gap-2">
                        <i class="bi bi-briefcase"></i> Ervaring
                    </h5>
                    <p class="text-muted">{{ profile.experience|e }}</p>
                </div>

                <hr>

                <div class="mb-4">
                    <h5 class="fw-bold text-success d-flex align-items-center gap-2">
                        <i class="bi bi-kanban"></i> Projecten
                    </h5>
                    <ul class="text-muted">
                        {% for project in profile.projects|split(';') %}
                            <li>{{ project|trim|e }}</li>
                        {% endfor %}
                    </ul>
                </div>

                <hr>

                <div class="mb-4">
                    <h5 class="fw-bold text-success d-flex align-items-center gap-2">
                        <i class="bi bi-envelope"></i> Contact
                    </h5>
                    <p class="text-muted">{{ profile.contact|e }}</p>
                </div>

                {% if isAdmin %}
                    <div class="d-flex justify-content-end mt-4">
                        <a href="/profile/edit" class="btn btn-success px-4 shadow-sm">
                            <i class="bi bi-pencil-square"></i> Bewerken
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>

    </div>
{% endblock %}
